# These are first-run defaults only. After the first launch the till keeps its own settings
# in IndexedDB, and staff change them on the Settings screen or the sign-in screen.

# mock: everything runs locally against a fault-injectable mock server with demo data.
# live: talk to the self-hosted Laravel API at VITE_API_BASE_URL.
VITE_API_MODE=mock

# LAN address of the Laravel app (no trailing slash). No public cloud host is assumed.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Suggested ZiG per 1 US$ when a shift is opened. The cashier confirms or edits it per shift.
VITE_DEFAULT_ZWG_RATE=26.80
